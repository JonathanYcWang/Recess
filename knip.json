{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["index.html", "src/Background/background.ts", "src/Background/content.ts"],
  "ignoreIssues": {
    "src/Background/Services/BlockListManagement/BlockListManagementService.ts": [
      "exports",
      "types"
    ],
    "src/Background/Services/Coin/CoinService.ts": ["exports", "files"],
    "src/Background/Services/Scheduler/SchedulerService.ts": ["exports"],
    "src/Background/Services/WorkStartReminder/WorkStartReminderService.ts": ["exports", "types", "files"],
    "src/Shared/Constants/Constants.ts": ["exports"],
    "src/Shared/Utils/TimerService.ts": ["exports"],
    "src/Shared/Types/AppState.ts": ["types"],
    "src/Shared/Types/Quiz.ts": ["types"],
    "src/UI/Redux/Selectors/Quiz/quizSelectors.ts": ["exports"]
  },
  "project": ["src/**/*.{ts,tsx}", "!src/**/*.test.{ts,tsx}"],
  "ignoreDependencies": ["@internationalized/date", "react-aria-components"],
  "ignoreFiles": [
    "src/UI/Components/PrizeWheel/**",
    "src/UI/Components/ParticleBurst/**",
    "src/UI/Components/QuizQuestion/**",
    "src/UI/Components/DurationInputDialog/**",
    "src/UI/Components/EnergyCheckDialog/**",
    "src/UI/Hooks/useParticles.ts",
    "src/UI/Pages/Quiz/**",
    "src/UI/Components/BlockedSites/BlockedSites.tsx",
    "src/UI/Components/EditTimeRangeOverlay/EditTimeRangeOverlay.tsx",
    "src/UI/Components/FocusTaskSelection/FocusTaskSelection.tsx",
    "src/UI/Components/TaskList/TaskList.tsx",
    "src/UI/Components/TimeField/TimeField.tsx",
    "src/UI/Components/Toggle/Toggle.tsx",
    "src/UI/Components/WorkHoursSettings/WorkHoursSettings.tsx",
    "src/Shared/Types/WorkStartReminder.ts",
    "src/UI/Views/FocusSessionCountdownView/**",
    "src/UI/Views/WorkSessionCompleteView/WorkSessionCompleteView.tsx"
  ],
  "vite": {
    "config": ["vite.config.ts"]
  }
}
